datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Entity {
  id             String             @id @default(uuid())
  name           String
  code           String             @unique
  dataMode       String             @default("NORMAL") // NORMAL, SAP
  sapServerUrl   String?
  sapCompanyDB   String?
  sapUser        String?
  sapPassword    String?
  sapQuery       String?  @db.Text
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  users          User[]
  bankEntities   BankEntity[]
  templateEntities TemplateEntity[]
  cheques        Cheque[]
  effets         Effet[]
  beneficiaries  Beneficiary[]
}

model User {
  id           String     @id @default(uuid())
  fullName     String
  username     String     @unique
  passwordHash String
  role         String     @default("COMPTABLE") // ADMIN, COMPTABLE, VISITEUR
  entityId     String?
  entity       Entity?    @relation(fields: [entityId], references: [id])
  active       Boolean    @default(true)
  canEdit      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Bank {
  id           String         @id @default(uuid())
  name         String
  code         String         @unique
  logoUrl      String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  bankEntities BankEntity[]
  templates    Template[]
  cheques      Cheque[]
  effets       Effet[]
}

model BankEntity {
  id       String   @id @default(uuid())
  bankId   String
  bank     Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  entityId String
  entity   Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([bankId, entityId])
}

model Template {
  id                 String             @id @default(uuid())
  bankId             String
  bank               Bank               @relation(fields: [bankId], references: [id])
  documentType       String             // CHEQUE, EFFET
  name               String
  backgroundImageUrl String?
  physicalWidthMm    Float              @default(210)
  physicalHeightMm   Float              @default(100)
  isActive           Boolean            @default(true)
  validFrom          DateTime           @default(now())
  validTo            DateTime?
  createdAt          DateTime           @default(now())
  fields             TemplateField[]
  templateEntities   TemplateEntity[]
  cheques            Cheque[]
  effets             Effet[]
}

model TemplateEntity {
  id         String   @id @default(uuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([templateId, entityId])
}

model TemplateField {
  id         String   @id @default(uuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey   String
  x          Float
  y          Float
  width      Float
  fontSize   Float    @default(10)
  fontFamily String   @default("Helvetica")
  align      String   @default("LEFT")
  format     String   @default("TEXT")
}

model Cheque {
  id            String    @id @default(uuid())
  bankId        String
  bank          Bank      @relation(fields: [bankId], references: [id])
  templateId    String
  template      Template  @relation(fields: [templateId], references: [id])
  entityId      String?
  entity        Entity?   @relation(fields: [entityId], references: [id])
  beneficiary   String
  amountNumeric  Decimal  @db.Decimal(12, 2)
  amountWords   String
  creationDate  DateTime  @default(now())
  creationPlace String
  status        String    @default("DRAFT")
  createdBy     String
  createdAt     DateTime  @default(now())
  printedAt     DateTime?
  deletedAt     DateTime?
}

model Effet {
  id            String    @id @default(uuid())
  bankId        String
  bank          Bank      @relation(fields: [bankId], references: [id])
  templateId    String
  template      Template  @relation(fields: [templateId], references: [id])
  entityId      String?
  entity        Entity?   @relation(fields: [entityId], references: [id])
  sapCode       String
  beneficiary   String
  dueDate       DateTime
  amountNumeric  Decimal  @db.Decimal(12, 2)
  amountWords   String
  creationDate  DateTime  @default(now())
  creationPlace String
  cause         String
  status        String    @default("DRAFT")
  createdBy     String
  createdAt     DateTime  @default(now())
  printedAt     DateTime?
  deletedAt     DateTime?
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  entityType String
  entityId   String
  action     String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())
}

model Beneficiary {
  id        String   @id @default(uuid())
  name      String
  code      String?
  category  String?  @default("FOURNISSEUR")
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, entityId])
}
